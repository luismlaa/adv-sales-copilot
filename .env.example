# ─────────────────────────────────────────────────────────────
# adv-sales-copilot · variables de entorno
# Copia a .env.local y llena los valores reales. NUNCA commitear .env*
# ─────────────────────────────────────────────────────────────

# ── Anthropic ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Modelo del calificador. Decision del brief: Haiku 4.5.
# Prohibida la cascada Haiku->Sonnet (las caches son model-scoped).
COPILOT_MODEL=claude-haiku-4-5
# Version de prompt activa en prompts/<version>/
PROMPT_VERSION=v1

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role: solo en el servidor (webhook, jobs). Jamas en el cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Bucket de Storage para documentos de identidad (cifrado en reposo)
SUPABASE_DOCS_BUCKET=expedientes

# ── WhatsApp Cloud API (Meta) ────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_ACCESS_TOKEN=EAA...
# Token que Meta devuelve en el handshake GET del webhook
WHATSAPP_VERIFY_TOKEN=cambiar-por-uno-aleatorio
# App secret de Meta — valida la firma X-Hub-Signature-256 del webhook
WHATSAPP_APP_SECRET=...
WHATSAPP_GRAPH_VERSION=v21.0

# ── Operacion ────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
# Tope de turnos por conversacion antes de escalar al vendedor
MAX_TURNS_PER_CONVERSATION=25
