{
  "name": "adv-sales-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Copiloto de ventas multi-tenant para dealers de vehiculos en RD: califica leads de WhatsApp, pre-filtra financiamiento contra las reglas del dealer y arma el expediente.",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed-demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "batch:nightly": "tsx src/jobs/nightly-summaries.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "exceljs": "^4.4.0",
    "next": "^15.5.0",
    "papaparse": "^5.5.3",
    "pino": "^9.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
